DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clothing_shop?schema=public"
# Schema vendor (vendor/backend-cms/prisma/schema.prisma) khai cả url lẫn directUrl —
# thiếu biến này thì app báo lỗi P1012 lúc kết nối DB. Local dev trỏ cùng DB nên giữ
# giống hệt DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/clothing_shop?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-user-access-secret"
JWT_REFRESH_SECRET="change-me-user-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Clothing Shop <no-reply@clothing-shop.com>"
SENTRY_DSN=""
# GHN — tính phí ship (khachhang.ghn.vn). ShopId khác Token dùng cho master-data sync bên
# backend-cms — endpoint /v2/shipping-order/* bắt buộc có ShopId.
GHN_API_TOKEN=""
GHN_API_BASE_URL="https://dev-online-gateway.ghn.vn/shiip/public-api"
GHN_SHOP_ID=""
# Quận/phường nơi shop gửi hàng (điểm "from" khi tính phí) — 1 shop 1 kho, cấu hình tĩnh.
GHN_FROM_DISTRICT_ID=""
GHN_FROM_WARD_CODE=""
# VNPay — cổng thanh toán online. TMN Code/Hash Secret lấy từ tài khoản sandbox/thật của
# VNPay (chưa đăng ký thì để trống — vẫn build/test được logic ký chữ ký với secret rỗng,
# chỉ không gọi được VNPay thật). Return URL trỏ về route FE (frontend-website) xử lý kết
# quả trả về, không phải URL của chính backend-user.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/payment/return"
# Thanh toán chuyển khoản thủ công — hiển thị tĩnh cho khách, admin tự đối soát rồi xác
# nhận qua backend-cms (PATCH /orders/:id/confirm-bank-transfer).
BANK_ACCOUNT_NUMBER=""
BANK_ACCOUNT_NAME=""
BANK_NAME=""
